<Window
    x:Class="AConsulting.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AConsulting">

    <!--
      HCW geography · W3+:
      Ribbon ≤5 · Stage = Clients · Projects · Office · Tasks · one orange commit · tray hub.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#ECEEF2" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="AConsulting" FontSize="18" FontWeight="SemiBold" Foreground="#141517"/>
                    <TextBlock Text="Accelerated Consulting" Opacity="0.65" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Practice" IsEnabled="False"/>
                    <Button x:Name="NavClientsBtn" Content="Clients" Click="NavClients_Click"/>
                    <Button x:Name="NavProjectsBtn" Content="Projects" Click="NavProjects_Click"/>
                    <Button x:Name="NavOfficeBtn" Content="Office" Click="NavOffice_Click"/>
                    <Button x:Name="NavTasksBtn" Content="Tasks" Click="NavTasks_Click"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="Local AI · desktop" Opacity="0.55"
                           VerticalAlignment="Center" FontSize="12"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Background="#F2F4F7" Padding="24">
            <Grid MaxWidth="960" HorizontalAlignment="Left">

                
                <StackPanel x:Name="PanelClients" Spacing="16" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Clients" FontSize="22" FontWeight="SemiBold" Foreground="#141517"/>
                        <TextBlock Text="Local client directory in firm.db. Publish clientStatus meta when ready for hub portals."
                                   Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Padding="16" CornerRadius="8" Background="#FFFFFF"
                            BorderBrush="#D0D4DC" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="New client" FontWeight="SemiBold"/>
                            <TextBox x:Name="ClientNameBox" Header="Name" PlaceholderText="Owner / developer firm"/>
                            <TextBox x:Name="ClientContactBox" Header="Contact" PlaceholderText="Primary person"/>
                            <TextBox x:Name="ClientEmailBox" Header="Email" PlaceholderText="ops@client.example"/>
                            <TextBox x:Name="ClientNotesBox" Header="Notes" AcceptsReturn="True"
                                     TextWrapping="Wrap" MinHeight="56"/>
                            <TextBlock Text="Local clients" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock x:Name="ClientListText" FontFamily="Consolas" FontSize="12"
                                       TextWrapping="Wrap"/>
                            <Button Content="Select next" Click="SelectNextClient_Click" MinHeight="44"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
<StackPanel x:Name="PanelProjects" Spacing="16" Visibility="Visible">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Projects · Engagements" FontSize="22" FontWeight="SemiBold" Foreground="#141517"/>
                        <TextBlock Text="Local engagements in firm.db. Publish status meta to the hub; import from AORMS Connect catalog."
                                   Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Padding="16" CornerRadius="8" Background="#FFFFFF"
                            BorderBrush="#D0D4DC" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="AORMS Connect" FontWeight="SemiBold"/>
                            <TextBlock Text="Pull catalog projects into engagements (idempotent on id)."
                                       Opacity="0.7" TextWrapping="Wrap"/>
                            <Button x:Name="ImportConnectBtn" Content="Import from Connect"
                                    Click="ImportCatalog_Click" MinHeight="44" MinWidth="180"/>
                            <TextBlock x:Name="CatalogImportNote" TextWrapping="Wrap" FontSize="12"
                                       Opacity="0.75"
                                       Text="No import yet — run AORMS Connect, then Import from Connect."/>
                        </StackPanel>
                    </Border>

                    <Border Padding="16" CornerRadius="8" Background="#FFFFFF"
                            BorderBrush="#D0D4DC" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="New engagement" FontWeight="SemiBold"/>
                            <TextBox x:Name="EngTitleBox" Header="Title" PlaceholderText="Structural PE · Tower A"/>
                            <TextBox x:Name="EngCodeBox" Header="Code / job #" PlaceholderText="ACE-2026-001"/>
                            <TextBox x:Name="EngStageBox" Header="Stage" PlaceholderText="Enquiry / Award / Delivery"/>
                            <TextBox x:Name="EngDisciplineBox" Header="Discipline" PlaceholderText="Structural / MEP"/>
                            <TextBlock Text="Local engagements" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock x:Name="EngListText" FontFamily="Consolas" FontSize="12"
                                       TextWrapping="Wrap"/>
                            <Button Content="Select next" Click="SelectNextEng_Click" MinHeight="44"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PanelOffice" Spacing="16" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Office · Enquiries" FontSize="22" FontWeight="SemiBold" Foreground="#141517"/>
                        <TextBlock Text="Go / no-go enquiry register in firm.db. Publish decision meta to the hub."
                                   Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Padding="16" CornerRadius="8" Background="#FFFFFF"
                            BorderBrush="#D0D4DC" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="New enquiry" FontWeight="SemiBold"/>
                            <TextBox x:Name="EnqSubjectBox" Header="Subject" PlaceholderText="Peer review · hospital block"/>
                            <TextBox x:Name="EnqClientBox" Header="Client / owner" PlaceholderText="Firm or developer"/>
                            <TextBox x:Name="EnqDecisionBox" Header="Decision" PlaceholderText="DRAFT · GO · NO_GO"/>
                            <TextBox x:Name="EnqNotesBox" Header="Notes" AcceptsReturn="True"
                                     TextWrapping="Wrap" MinHeight="64"/>
                            <TextBlock Text="Local enquiries" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock x:Name="EnqListText" FontFamily="Consolas" FontSize="12"
                                       TextWrapping="Wrap"/>
                            <Button Content="Select next" Click="SelectNextEnq_Click" MinHeight="44"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PanelTasks" Spacing="16" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Tasks" FontSize="22" FontWeight="SemiBold" Foreground="#141517"/>
                        <TextBlock Text="Create locally, then publish once. Hub sync and licence live in the tray below."
                                   Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Padding="16" CornerRadius="8" Background="#FFFFFF"
                            BorderBrush="#D0D4DC" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Task board" FontWeight="SemiBold"/>
                            <TextBox x:Name="TaskTitleBox" Header="Title" PlaceholderText="Task title"/>
                            <TextBox x:Name="TaskProjectBox" Header="Engagement / project id (UUID)"
                                     PlaceholderText="Uses selected engagement when set"/>
                            <TextBlock x:Name="TaskListText" FontFamily="Consolas" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Technical calc lives in AQC Estimation / BBS / PM. Launch from AORMS Connect."
                               Opacity="0.55" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#ECEEF2" Padding="16,8" BorderBrush="#D0D4DC" BorderThickness="0,1,0,0">
            <Grid MaxWidth="960">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Clear form" Click="ClearForm_Click" MinHeight="44"/>
                    <Button x:Name="DockImportBtn" Content="Import from Connect"
                            Click="ImportCatalog_Click" MinHeight="44" Visibility="Visible"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="DockCreateBtn" Content="Save engagement" Click="DockCreate_Click"
                            MinHeight="44" MinWidth="140"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="DockReloadBtn" Content="Reload" Click="DockReload_Click" MinHeight="44"/>
                    <Button x:Name="DockCommitBtn" Content="Publish status" Click="DockCommit_Click"
                            Background="#FF4F18" Foreground="White" MinHeight="44" MinWidth="140"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#ECEEF2" Padding="16,8" BorderBrush="#D0D4DC" BorderThickness="0,1,0,0">
            <StackPanel Spacing="6">
                <TextBlock x:Name="TrayText" Text="AConsulting · Projects"
                           FontSize="11" Opacity="0.55"/>
                <TextBlock x:Name="HubStatusText" TextWrapping="Wrap" FontSize="12"/>
                <TextBlock x:Name="LogText" Opacity="0.7" TextWrapping="Wrap"
                           FontFamily="Consolas" FontSize="11"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="LicenseKeyBox" Width="280"
                             PlaceholderText="License key (HLP-…)" Header="Activate"/>
                    <Button Content="Activate" Click="Activate_Click" VerticalAlignment="Bottom"/>
                    <Button Content="Flush meta" Click="Flush_Click" VerticalAlignment="Bottom"/>
                    <Button Content="Refresh" Click="Refresh_Click" VerticalAlignment="Bottom"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
