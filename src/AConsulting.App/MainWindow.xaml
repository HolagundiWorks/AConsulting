<Window
    x:Class="AConsulting.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AConsulting">

    <!--
      HCW geography (capacity pass):
      Ribbon ≤5 peers · Stage = Tasks only · one orange commit · Hub/license in tray.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#ECEEF2" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="AConsulting" FontSize="18" FontWeight="SemiBold" Foreground="#141517"/>
                    <TextBlock Text="Accelerated Consulting" Opacity="0.65" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Practice" Style="{StaticResource SubtleButtonStyle}" IsEnabled="False"/>
                    <Button Content="Clients" Style="{StaticResource SubtleButtonStyle}" IsEnabled="False"/>
                    <Button Content="Projects" Style="{StaticResource SubtleButtonStyle}" IsEnabled="False"/>
                    <Button Content="Office" Style="{StaticResource SubtleButtonStyle}" IsEnabled="False"/>
                    <Button Content="Tasks" Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="Local AI · desktop" Opacity="0.55"
                           VerticalAlignment="Center" FontSize="12"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Background="#F2F4F7" Padding="24">
            <Grid MaxWidth="960" HorizontalAlignment="Left" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Tasks" FontSize="22" FontWeight="SemiBold" Foreground="#141517"/>
                    <TextBlock Text="Create locally, then publish once. Hub sync and licence live in the tray below."
                               Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Row="1" Padding="16" CornerRadius="8" Background="#FFFFFF"
                        BorderBrush="#D0D4DC" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Task board" FontWeight="SemiBold"/>
                        <TextBlock Text="ActionDock: Clear · Save local · Publish to hub (commit)."
                                   Opacity="0.7" FontSize="12"/>
                        <TextBox x:Name="TaskTitleBox" Header="Title" PlaceholderText="Task title"/>
                        <TextBox x:Name="TaskProjectBox" Header="Project id (UUID)"
                                 Text="00000000-0000-0000-0000-000000000001"/>
                        <TextBlock x:Name="TaskListText" FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="2"
                           Text="Technical calc lives in AQC Estimation / BBS / PM. Launch from AORMS Connect."
                           Opacity="0.55" TextWrapping="Wrap" FontSize="12"/>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#ECEEF2" Padding="16,8" BorderBrush="#D0D4DC" BorderThickness="0,1,0,0">
            <Grid MaxWidth="960">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Clear form" Click="ClearForm_Click" MinHeight="44"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Save local" Click="SaveTaskLocal_Click" MinHeight="44" MinWidth="120"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Reload" Click="ReloadTasks_Click" MinHeight="44"/>
                    <Button Content="Publish to hub" Click="PublishTask_Click"
                            Background="#FF4F18" Foreground="White" MinHeight="44" MinWidth="140"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#ECEEF2" Padding="16,8" BorderBrush="#D0D4DC" BorderThickness="0,1,0,0">
            <StackPanel Spacing="6">
                <TextBlock Text="Sync tray · hub + licence"
                           FontSize="11" Opacity="0.55"/>
                <TextBlock x:Name="HubStatusText" TextWrapping="Wrap" FontSize="12"/>
                <TextBlock x:Name="LogText" Opacity="0.7" TextWrapping="Wrap"
                           FontFamily="Consolas" FontSize="11"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="LicenseKeyBox" Width="280"
                             PlaceholderText="License key (HLP-…)" Header="Activate"/>
                    <Button Content="Activate" Click="Activate_Click" VerticalAlignment="Bottom"/>
                    <Button Content="Flush meta" Click="Flush_Click" VerticalAlignment="Bottom"/>
                    <Button Content="Refresh" Click="Refresh_Click" VerticalAlignment="Bottom"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
