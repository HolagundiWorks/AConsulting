<Window
    x:Class="AConsulting.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AConsulting">

    <!--
      HCW geography · DESKTOP-WINUI-UX.md (manager full shell):
      App title bar · floating ribbon 56 · Fog stage · ActionDock · taskbar 60 · density 1×.
      Module nav in taskbar (not ribbon).
    -->
    <Grid Background="{StaticResource HcwFogBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Padding="12,0,140,0"
              Background="{StaticResource HcwFogBrush}"
              AutomationProperties.Name="App title bar">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock Text="AConsulting" FontSize="12" FontWeight="SemiBold"
                           FontFamily="{StaticResource HcwFontFamily}"
                           Foreground="{StaticResource HcwInkBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="·" Foreground="{StaticResource HcwMutedBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleBarText" Text="Practice" FontSize="12"
                           FontFamily="{StaticResource HcwFontFamily}"
                           Foreground="{StaticResource HcwMutedBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="480"/>
            </StackPanel>
        </Grid>

        <!-- TOP RIBBON — brand · Local AI (modules live in taskbar) -->
        <Grid Grid.Row="1" Height="56" Margin="16,8,16,8">
            <Border CornerRadius="8" Background="{StaticResource HcwNeuDarkBrush}" Margin="6,6,0,0"/>
            <Border CornerRadius="8" Background="{StaticResource HcwNeuLightBrush}" Margin="0,0,6,6"/>
            <Border CornerRadius="8" Background="{StaticResource HcwSoftBrush}">
                <Grid Padding="16,0" Height="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="AConsulting" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource HcwInkBrush}"
                                   FontFamily="{StaticResource HcwFontFamily}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Accelerated Consulting" Opacity="0.55" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource HcwInkBrush}"/>
                    </StackPanel>
                    <Grid Grid.Column="2" Height="35" VerticalAlignment="Center">
                        <Border CornerRadius="8" Background="{StaticResource HcwNeuDarkBrush}" Margin="3,3,0,0"/>
                        <Border CornerRadius="8" Background="{StaticResource HcwNeuLightBrush}" Margin="0,0,3,3"/>
                        <Border CornerRadius="8" Background="{StaticResource HcwSoftBrush}" Padding="10,0">
                            <TextBlock x:Name="LocalAiBadge" Text="Local AI · desktop"
                                       Style="{StaticResource HcwLabel}" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer Background="{StaticResource HcwFogBrush}"
                          Padding="24,24,24,180"
                          VerticalScrollBarVisibility="Auto">
                <Grid HorizontalAlignment="Stretch">

                    <StackPanel x:Name="PanelPractice" Spacing="16" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Practice" Style="{StaticResource HcwTitleText}"/>
                            <TextBlock Text="Capacity · firm notes · Ask ESTI on local Ollama (never the cloud hub)."
                                       Style="{StaticResource HcwBodyMuted}"/>
                        </StackPanel>
                        <Border Style="{StaticResource HcwFlatCard}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Local capacity" FontWeight="SemiBold"
                                           Foreground="{StaticResource HcwInkBrush}"/>
                                <TextBlock x:Name="PracticeCountsText" FontFamily="Consolas" FontSize="12"
                                           TextWrapping="Wrap" Foreground="{StaticResource HcwInkBrush}"/>
                                <TextBlock x:Name="PracticeHubText" FontFamily="Consolas" FontSize="12"
                                           Opacity="0.8" TextWrapping="Wrap"
                                           Foreground="{StaticResource HcwInkBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HcwFlatCard}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Ask ESTI · local" FontWeight="SemiBold"
                                           Foreground="{StaticResource HcwInkBrush}"/>
                                <TextBlock x:Name="EstiStatusText"
                                           Text="Probe Ollama to check local runtime."
                                           Style="{StaticResource HcwBodyMuted}" FontSize="12"/>
                                <TextBox x:Name="EstiPromptBox" Header="Question"
                                         PlaceholderText="What should we decide on open GO enquiries?"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Ask ESTI" Click="AskEsti_Click" Style="{StaticResource HcwPrimaryButton}"
                                            MinWidth="120"/>
                                    <Button Content="Probe Ollama" Click="ProbeOllama_Click" Style="{StaticResource HcwDockButton}"/>
                                </StackPanel>
                                <TextBlock x:Name="EstiReplyText" TextWrapping="Wrap" FontSize="13"
                                           Foreground="{StaticResource HcwInkBrush}"/>
                                <TextBlock Text="Transcripts stay on this machine — never synced. Env: ESTI_OLLAMA_URL · ESTI_OLLAMA_MODEL."
                                           Style="{StaticResource HcwLabel}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HcwFlatCard}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Firm profile" FontWeight="SemiBold"
                                           Foreground="{StaticResource HcwInkBrush}"/>
                                <TextBox x:Name="PracticeFirmBox" Header="Firm name" PlaceholderText="Consulting practice"/>
                                <TextBox x:Name="PracticeNotesBox" Header="Practice notes" AcceptsReturn="True"
                                         TextWrapping="Wrap" MinHeight="80"/>
                                <TextBlock Text="Dock: Save notes · Flush meta. Licence from AORMS Connect; Flush on taskbar."
                                           Style="{StaticResource HcwLabel}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelClients" Spacing="16" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Clients" Style="{StaticResource HcwTitleText}"/>
                            <TextBlock Text="Local client directory in firm.db. Publish clientStatus meta when ready for hub portals."
                                       Style="{StaticResource HcwBodyMuted}"/>
                        </StackPanel>
                        <Border Style="{StaticResource HcwFlatCard}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="New client" FontWeight="SemiBold"
                                           Foreground="{StaticResource HcwInkBrush}"/>
                                <TextBox x:Name="ClientNameBox" Header="Name" PlaceholderText="Owner / developer firm"/>
                                <TextBox x:Name="ClientContactBox" Header="Contact" PlaceholderText="Primary person"/>
                                <TextBox x:Name="ClientEmailBox" Header="Email" PlaceholderText="ops@client.example"/>
                                <TextBox x:Name="ClientNotesBox" Header="Notes" AcceptsReturn="True"
                                         TextWrapping="Wrap" MinHeight="56"/>
                                <TextBlock Text="Local clients" FontWeight="SemiBold" Margin="0,8,0,0"
                                           Foreground="{StaticResource HcwInkBrush}"/>
                                <TextBlock x:Name="ClientListText" FontFamily="Consolas" FontSize="12"
                                           TextWrapping="Wrap" Foreground="{StaticResource HcwInkBrush}"/>
                                <Button Content="Select next" Click="SelectNextClient_Click" Style="{StaticResource HcwDockButton}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelProjects" Spacing="16" Visibility="Visible">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Projects · Engagements" Style="{StaticResource HcwTitleText}"/>
                            <TextBlock Text="Local engagements in firm.db. Publish status meta to the hub; import from AORMS Connect catalog."
                                       Style="{StaticResource HcwBodyMuted}"/>
                        </StackPanel>
                        <Border Style="{StaticResource HcwFlatCard}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="AORMS Connect" FontWeight="SemiBold"
                                           Foreground="{StaticResource HcwInkBrush}"/>
                                <TextBlock Text="Pull catalog projects into engagements (idempotent on id)."
                                           Style="{StaticResource HcwBodyMuted}"/>
                                <Button x:Name="ImportConnectBtn" Content="Import from Connect"
                                        Click="ImportCatalog_Click" Style="{StaticResource HcwDockButton}" MinWidth="180"/>
                                <TextBlock x:Name="CatalogImportNote" TextWrapping="Wrap" FontSize="12"
                                           Opacity="0.75" Foreground="{StaticResource HcwInkBrush}"
                                           Text="No import yet — run AORMS Connect, then Import from Connect."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HcwFlatCard}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="New engagement" FontWeight="SemiBold"
                                           Foreground="{StaticResource HcwInkBrush}"/>
                                <TextBox x:Name="EngTitleBox" Header="Title" PlaceholderText="Structural PE · Tower A"/>
                                <TextBox x:Name="EngCodeBox" Header="Code / job #" PlaceholderText="ACE-2026-001"/>
                                <TextBox x:Name="EngStageBox" Header="Stage" PlaceholderText="Enquiry / Award / Delivery"/>
                                <TextBox x:Name="EngDisciplineBox" Header="Discipline" PlaceholderText="Structural / MEP"/>
                                <TextBlock Text="Local engagements" FontWeight="SemiBold" Margin="0,8,0,0"
                                           Foreground="{StaticResource HcwInkBrush}"/>
                                <TextBlock x:Name="EngListText" FontFamily="Consolas" FontSize="12"
                                           TextWrapping="Wrap" Foreground="{StaticResource HcwInkBrush}"/>
                                <Button Content="Select next" Click="SelectNextEng_Click" Style="{StaticResource HcwDockButton}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelOffice" Spacing="16" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Office · Enquiries" Style="{StaticResource HcwTitleText}"/>
                            <TextBlock Text="Go / no-go enquiry register in firm.db. Publish decision meta to the hub."
                                       Style="{StaticResource HcwBodyMuted}"/>
                        </StackPanel>
                        <Border Style="{StaticResource HcwFlatCard}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="New enquiry" FontWeight="SemiBold"
                                           Foreground="{StaticResource HcwInkBrush}"/>
                                <TextBox x:Name="EnqSubjectBox" Header="Subject" PlaceholderText="Peer review · hospital block"/>
                                <TextBox x:Name="EnqClientBox" Header="Client / owner" PlaceholderText="Firm or developer"/>
                                <TextBox x:Name="EnqDecisionBox" Header="Decision" PlaceholderText="DRAFT · GO · NO_GO"/>
                                <TextBox x:Name="EnqNotesBox" Header="Notes" AcceptsReturn="True"
                                         TextWrapping="Wrap" MinHeight="64"/>
                                <TextBlock Text="Local enquiries" FontWeight="SemiBold" Margin="0,8,0,0"
                                           Foreground="{StaticResource HcwInkBrush}"/>
                                <TextBlock x:Name="EnqListText" FontFamily="Consolas" FontSize="12"
                                           TextWrapping="Wrap" Foreground="{StaticResource HcwInkBrush}"/>
                                <Button Content="Select next" Click="SelectNextEnq_Click" Style="{StaticResource HcwDockButton}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelTasks" Spacing="16" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Tasks" Style="{StaticResource HcwTitleText}"/>
                            <TextBlock Text="Create locally, then publish once. Hub sync and licence live in the taskbar."
                                       Style="{StaticResource HcwBodyMuted}"/>
                        </StackPanel>
                        <Border Style="{StaticResource HcwFlatCard}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Task board" FontWeight="SemiBold"
                                           Foreground="{StaticResource HcwInkBrush}"/>
                                <TextBox x:Name="TaskTitleBox" Header="Title" PlaceholderText="Task title"/>
                                <TextBox x:Name="TaskProjectBox" Header="Engagement / project id (UUID)"
                                         PlaceholderText="Uses selected engagement when set"/>
                                <TextBlock x:Name="TaskListText" FontFamily="Consolas" FontSize="12"
                                           TextWrapping="Wrap" Foreground="{StaticResource HcwInkBrush}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Technical calc lives in AQC Estimation / BBS / PM. Launch from AORMS Connect."
                                   Style="{StaticResource HcwLabel}"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ActionDock — LEFT destroy · CENTER save · RIGHT reload/publish -->
            <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,92">
                <Border CornerRadius="8" Background="{StaticResource HcwNeuDarkBrush}" Margin="5,5,0,0"/>
                <Border CornerRadius="8" Background="{StaticResource HcwNeuLightBrush}" Margin="0,0,5,5"/>
                <Border CornerRadius="8" Background="{StaticResource HcwSoftBrush}" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Clear" Click="ClearForm_Click" Style="{StaticResource HcwDockDanger}"/>
                            <Button x:Name="DockImportBtn" Content="Import" Click="ImportCatalog_Click"
                                    Style="{StaticResource HcwDockButton}" Visibility="Visible"/>
                        </StackPanel>
                        <Border Style="{StaticResource HcwDockGroove}"/>
                        <Button x:Name="DockCreateBtn" Content="Save" Click="DockCreate_Click"
                                Style="{StaticResource HcwDockPrimary}" MinWidth="140"/>
                        <Border Style="{StaticResource HcwDockGroove}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="DockReloadBtn" Content="Reload" Click="DockReload_Click"
                                    Style="{StaticResource HcwDockButton}"/>
                            <Button x:Name="DockCommitBtn" Content="Publish" Click="DockCommit_Click"
                                    Style="{StaticResource HcwDockPrimary}" MinWidth="120"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Taskbar — module nav CENTER · Flush / licence status RIGHT -->
            <Grid VerticalAlignment="Bottom" Margin="16,0,16,16" Height="60">
                <Border CornerRadius="8" Background="{StaticResource HcwNeuDarkBrush}" Margin="6,6,0,0"/>
                <Border CornerRadius="8" Background="{StaticResource HcwNeuLightBrush}" Margin="0,0,6,6"/>
                <Border CornerRadius="8" Background="{StaticResource HcwSoftBrush}" Padding="12,0">
                    <Grid Height="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="TrayText" Text="AConsulting"
                                       Style="{StaticResource HcwLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Button x:Name="NavPracticeBtn" Content="Practice" Style="{StaticResource HcwGhostButton}"
                                    Click="NavPractice_Click"/>
                            <Button x:Name="NavClientsBtn" Content="Clients" Style="{StaticResource HcwGhostButton}"
                                    Click="NavClients_Click"/>
                            <Button x:Name="NavProjectsBtn" Content="Projects" Style="{StaticResource HcwGhostButton}"
                                    Click="NavProjects_Click"/>
                            <Button x:Name="NavOfficeBtn" Content="Office" Style="{StaticResource HcwGhostButton}"
                                    Click="NavOffice_Click"/>
                            <Button x:Name="NavTasksBtn" Content="Tasks" Style="{StaticResource HcwGhostButton}"
                                    Click="NavTasks_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="LicenceChipText" Text="Licence · Connect"
                                       Style="{StaticResource HcwLabel}" VerticalAlignment="Center"
                                       ToolTipService.ToolTip="Activate only in AORMS Connect; this app imports session.json"/>
                            <Button Content="Re-import" Click="ReimportConnectSession_Click"
                                    Style="{StaticResource HcwGhostButton}"
                                    ToolTipService.ToolTip="Re-import %LocalAppData%\AORMS-Connect\session.json"/>
                            <Button Content="Flush" Click="Flush_Click" Style="{StaticResource HcwDockPrimary}"/>
                            <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource HcwGhostButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Status strip above clock area (compact) -->
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left"
                        Margin="24,0,24,84" MaxWidth="420" Spacing="2" IsHitTestVisible="False">
                <TextBlock x:Name="HubStatusText" TextWrapping="Wrap" FontSize="11" Opacity="0.65"
                           Foreground="{StaticResource HcwInkBrush}"/>
                <TextBlock x:Name="LogText" Opacity="0.55" TextWrapping="Wrap"
                           FontFamily="Consolas" FontSize="10"
                           Foreground="{StaticResource HcwInkBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
